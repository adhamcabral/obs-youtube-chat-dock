#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
BUILD_DIR="$ROOT_DIR/build"
PREFIX="${OBS_PLUGIN_PREFIX:-$HOME/.config/obs-studio/plugins}"

has() {
	command -v "$1" >/dev/null 2>&1
}

install_deps() {
	if has pacman; then
		sudo pacman -S --needed \
			base-devel \
			cmake \
			qt6-base
		return
	fi

	if has apt-get; then
		sudo apt-get update
		sudo apt-get install -y \
			build-essential \
			cmake \
			libobs-dev \
			pkg-config \
			qt6-base-dev \
			qt6-base-dev-tools
		return
	fi

	if has dnf; then
		sudo dnf install -y \
			cmake \
			gcc-c++ \
			make \
			obs-studio-devel \
			pkgconf-pkg-config \
			qt6-qtbase-devel
		return
	fi

	if has zypper; then
		sudo zypper install -y \
			cmake \
			gcc-c++ \
			make \
			obs-studio-devel \
			pkg-config \
			qt6-base-devel
		return
	fi

	printf 'Nao encontrei pacman, apt-get, dnf ou zypper.\n' >&2
	printf 'Instale manualmente: compilador C++, cmake, OBS headers e Qt6 Widgets/Network.\n' >&2
	exit 1
}

require_obs() {
	if has obs; then
		return
	fi

	printf 'OBS nao foi encontrado no PATH.\n' >&2
	printf 'Instale o OBS antes de rodar este instalador.\n' >&2
	exit 1
}

require_obs
install_deps

cmake -S "$ROOT_DIR" -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Release
cmake --build "$BUILD_DIR" --config Release
cmake --install "$BUILD_DIR" --prefix "$PREFIX"

printf 'Plugin instalado em: %s\n' "$PREFIX/chat-dock/bin/64bit/chat-dock.so"
